{
  "name": "opencode-theme-select",
  "version": "0.2.0",
  "description": "opencode plugin: /theme-select to pick and apply a theme (built-in or custom) to the project's tui.json",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "bin": {
    "theme-select": "bin/theme-select.js"
  },
  "files": [
    "src",
    "bin",
    "command",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "theme",
    "tui",
    "theme-select"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  }
}
